# --- Supabase ------------------------------------------------------------
# Project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Never expose this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Project settings -> Database -> Connection string -> URI
# Only read by `npm run db:migrate` and `npm run db:seed`.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# --- Site ----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=JDSATISFACTION SERVICES PLUS
NEXT_PUBLIC_CURRENCY=HTG
# Taux du jour : 1 USD = X gourdes (à mettre à jour chaque jour)
NEXT_PUBLIC_USD_HTG_RATE=132
NEXT_PUBLIC_USD_HTG_RATE_DATE=23 août 2026

# --- Contact & retrait boutique ------------------------------------------
NEXT_PUBLIC_STORE_PHONE=+50900000000
NEXT_PUBLIC_STORE_WHATSAPP=50900000000
NEXT_PUBLIC_STORE_EMAIL=contact@example.com
NEXT_PUBLIC_STORE_PICKUP_LABEL=Boutique JDSATISFACTION SERVICES PLUS
NEXT_PUBLIC_STORE_ADDRESS_LINE1=123 Avenue Principale
NEXT_PUBLIC_STORE_ADDRESS_LINE2=
NEXT_PUBLIC_STORE_CITY=Port-au-Prince
NEXT_PUBLIC_STORE_HOURS=Lun–Sam : 9h – 18h
NEXT_PUBLIC_STORE_MAPS_URL=https://maps.google.com/?q=JDSATISFACTION+SERVICES+PLUS

# --- Paiements ------------------------------------------------------------
# Virement bancaire (affiché sur le site — sauf IBAN/Swift, usage interne)
NEXT_PUBLIC_STORE_BANK_NAME=Banque Nationale
NEXT_PUBLIC_STORE_BANK_ACCOUNT_NAME=JDSATISFACTION SERVICES PLUS
NEXT_PUBLIC_STORE_BANK_ACCOUNT_NUMBER=0000000000
# Non affichés publiquement
STORE_BANK_IBAN=
STORE_BANK_SWIFT=

# Mobile money (NatCash, MonCash)
NEXT_PUBLIC_STORE_NATCASH_NAME=JDSATISFACTION SERVICES PLUS
NEXT_PUBLIC_STORE_NATCASH_NUMBER=00000000
NEXT_PUBLIC_STORE_MONCASH_NAME=JDSATISFACTION SERVICES PLUS
NEXT_PUBLIC_STORE_MONCASH_NUMBER=00000000

# Stripe (carte bancaire) — à configurer plus tard
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
